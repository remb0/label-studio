LABEL_STUDIO_BIND=127.0.0.1
LABEL_STUDIO_PORT=3022
COMMIT_SHA=local
# Production: set an immutable image reference from GitHub Container Registry.
# LABEL_STUDIO_IMAGE=ghcr.io/remb0/label-studio@sha256:...

# MySQL account API. Replace the password and public URL before production.
MYSQL_DATABASE=label_studio
MYSQL_USER=label_studio
MYSQL_PASSWORD=replace-with-a-long-random-password
PUBLIC_APP_URL=http://127.0.0.1:3022
SESSION_DAYS=30
# Optional extra origins of this deployment, comma-separated.
ALLOWED_ORIGINS=
# Comma-separated e-mail addresses that may moderate printer reports.
ADMIN_EMAILS=
VITE_ACCOUNT_API_URL=/api

# SMTP is required for password-recovery email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
